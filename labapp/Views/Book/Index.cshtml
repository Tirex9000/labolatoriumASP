@model List<Book>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Książki</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Dodaj książkę</a>
<table class="table">
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Autor</th>
            <th>Rok</th>
            <th>Cena</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in @Model)
        {
            @* <partial name="_BookRow" model="b" /> *@
            <tr>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td>@b.PublicationDate?.Year</td>
                <td>@b.Price.ToString("C")</td>
            </tr> 
        }
    </tbody>
</table>